  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "layerId": {"type": "string", "pattern": "^layer\\.[a-z0-9.-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pixelCount": {"type": "integer", "minimum": 0, "maximum": 1638400},
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "applicability", "side", "status", "semantic_sources", "visible_pixel_count"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/id"},
        "applicability": {"enum": ["required", "conditional", "optional"]},
        "side": {"enum": ["left", "right", "not-applicable"]},
        "status": {"enum": ["PRESENT", "NOT_APPLICABLE", "LOW_CONFIDENCE"]},
        "semantic_sources": {"type": "array", "maxItems": 23, "uniqueItems": true, "items": {"$ref": "#/$defs/semantic"}},
        "visible_pixel_count": {"$ref": "#/$defs/pixelCount"}
      }
    },
    "semantic": {"enum": ["back hair", "tail", "wings", "neck", "topwear", "bottomwear", "legwear", "footwear", "face", "ears", "eyewhite", "irides", "eyebrow", "nose", "mouth", "eyelash", "front hair", "headwear", "neckwear", "handwear", "eyewear", "earwear", "objects", "eye", "union"]},
    "maskArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri", "media_type", "byte_length", "sha256", "width", "height", "mode", "pixel_count"],
      "properties": {
        "id": {"type": "string", "pattern": "^mask\\.[a-z0-9.-]{2,127}$"},
        "uri": {"type": "string", "pattern": "^model-candidate-preflight/mask\\.[a-z0-9.-]+\\.png$"},
        "media_type": {"const": "image/png"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "sha256": {"$ref": "#/$defs/sha256"},
        "width": {"const": 1280},
        "height": {"const": 1280},
        "mode": {"const": "L"},
        "pixel_count": {"$ref": "#/$defs/pixelCount"}
      }
    },
    "generatedRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "semantic", "mask", "producer", "confidence", "motion_reveal_scope", "feather_pixels"],
      "properties": {
        "kind": {"enum": ["source-transparent-exposed", "deterministic-underpaint", "model-hidden-completion"]},
        "semantic": {"$ref": "#/$defs/semantic"},
        "mask": {"$ref": "#/$defs/maskArtifact"},
        "producer": {"enum": ["model-source-preserve-v6", "oc2d.spike.model-motion-draft.affine-semantic.v15", "see-through.v3.nf4.1280.source-preserve.v6"]},
        "confidence": {"const": "not_available_review_required"},
        "motion_reveal_scope": {"enum": ["shared-37-frame-research-draft", "head.yaw/head.pitch"]},
        "feather_pixels": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "motionLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion_layer_id", "semantic", "side", "source_artifact_id", "operations", "binding_ids", "motion_reveal_scope"],
      "properties": {
        "motion_layer_id": {"$ref": "#/$defs/layerId"},
        "semantic": {"$ref": "#/$defs/semantic"},
        "side": {"enum": ["left", "right", "not-applicable"]},
        "source_artifact_id": {"type": "string", "pattern": "^[a-zA-Z0-9_.+-]{3,511}$"},
        "operations": {"type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["source-preserve-v6-alpha-clean", "subject-matte", "bbox-crop-padding-4", "deterministic-face-underpaint", "source-visible-feature-rgb", "grouped-eye-mask"]}},
        "binding_ids": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^binding\\.[a-z0-9-]{3,63}$"}},
        "motion_reveal_scope": {"const": "shared-37-frame-research-draft"}
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer_id", "vertices_xy", "triangle_indices", "winding"],
      "properties": {
        "id": {"type": "string", "pattern": "^mesh\\.[a-z0-9.-]{2,127}$"},
        "layer_id": {"$ref": "#/$defs/layerId"},
        "vertices_xy": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 1280}}},
        "triangle_indices": {"const": [0, 1, 2, 0, 2, 3]},
        "winding": {"const": "positive-screen-y-down"}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "range", "default", "interpolation", "extrapolation"],
      "properties": {
        "id": {"enum": ["head.yaw", "head.pitch", "eye.left.open", "eye.right.open", "mouth.open"]},
        "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -15, "maximum": 15}},
        "default": {"type": "number", "minimum": 0, "maximum": 1},
        "interpolation": {"const": "linear"},
        "extrapolation": {"const": "clamp"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter_id", "target_layer_ids", "kind", "interpolation", "extrapolation"],
      "properties": {
        "id": {"type": "string", "pattern": "^binding\\.[a-z0-9-]{3,63}$"},
        "parameter_id": {"enum": ["head.yaw", "head.pitch", "eye.left.open", "eye.right.open", "mouth.open"]},
        "target_layer_ids": {"type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": {"$ref": "#/$defs/layerId"}},
        "kind": {"enum": ["affine-shear-translate", "affine-translate", "affine-scale-y"]},
        "interpolation": {"const": "linear"},
        "extrapolation": {"const": "clamp"}
      }
    },
    "frameParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head.yaw", "head.pitch", "eye.left.open", "eye.right.open", "mouth.open"],
      "properties": {
        "head.yaw": {"type": "number", "minimum": -15, "maximum": 15},
        "head.pitch": {"type": "number", "minimum": -10, "maximum": 10},
        "eye.left.open": {"type": "number", "minimum": 0, "maximum": 1},
        "eye.right.open": {"type": "number", "minimum": 0, "maximum": 1},
        "mouth.open": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "frameArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri", "media_type", "byte_length", "sha256", "width", "height", "mode"],
      "properties": {
        "id": {"type": "string", "pattern": "^candidate-frame-(?:0[0-9]|[12][0-9]|3[0-6])$"},
        "uri": {"type": "string", "pattern": "^model-candidate-preflight/candidate-frame-(?:00[0-9]|0[12][0-9]|03[0-6])\\.png$"},
        "media_type": {"const": "image/png"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "sha256": {"$ref": "#/$defs/sha256"},
        "width": {"const": 1280},
        "height": {"const": 1280},
        "mode": {"const": "RGBA"}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "id", "source", "parameters", "artifact"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 36},
        "id": {"$ref": "#/$defs/id"},
        "source": {"enum": ["mandatory", "seeded-trajectory"]},
        "parameters": {"$ref": "#/$defs/frameParameters"},
        "artifact": {"$ref": "#/$defs/frameArtifact"}
      }
    },
    "geometryValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_finite", "valid_indices", "positive_area_all_frames", "sample_count", "minimum_signed_area2", "neutral_visible_pixel_count", "neutral_reconstruction_rgb_exact_ratio", "neutral_reconstruction_rgb_mae"],
      "properties": {
        "all_finite": {"const": true},
        "valid_indices": {"const": true},
        "positive_area_all_frames": {"const": true},
        "sample_count": {"type": "integer", "minimum": 222, "maximum": 1480},
        "minimum_signed_area2": {"type": "number", "minimum": 0.000001, "maximum": 10000000},
        "neutral_visible_pixel_count": {"type": "integer", "minimum": 1, "maximum": 1638400},
        "neutral_reconstruction_rgb_exact_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "neutral_reconstruction_rgb_mae": {"type": "number", "minimum": 0, "maximum": 255}
      }
    }
  }
}
