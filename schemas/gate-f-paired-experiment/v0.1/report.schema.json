{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oneclick2d.invalid/gate-f-paired-experiment/v0.1/report.schema.json",
  "title": "OneClick2D Gate F Paired Experiment Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_count", "wins", "losses", "ties", "net_margin", "net_margin_rate", "exact_one_sided_p", "exact_one_sided_p_fraction", "clopper_pearson_95", "f_usable_count", "superiority_pass", "f_usable_pass", "primary_pair_rule_pass"],
  "properties": {
    "asset_count": {"const": 20},
    "wins": {"type": "integer", "minimum": 0, "maximum": 20},
    "losses": {"type": "integer", "minimum": 0, "maximum": 20},
    "ties": {"type": "integer", "minimum": 0, "maximum": 20},
    "net_margin": {"type": "integer", "minimum": -20, "maximum": 20},
    "net_margin_rate": {"type": "number", "minimum": -1, "maximum": 1},
    "exact_one_sided_p": {"type": "number", "minimum": 0, "maximum": 1},
    "exact_one_sided_p_fraction": {"type": "string", "pattern": "^[0-9]+/[0-9]+$"},
    "clopper_pearson_95": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "f_usable_count": {"type": "integer", "minimum": 0, "maximum": 20},
    "superiority_pass": {"type": "boolean"},
    "f_usable_pass": {"type": "boolean"},
    "primary_pair_rule_pass": {"type": "boolean"}
  }
}
