{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oneclick2d.invalid/gate-f-simple-cutout-comparator/v0.3/report.schema.json",
  "title": "OneClick2D Gate F Simple-Cutout Comparator Report v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "scope", "adapter_id", "adapter_version", "contract_id", "config_sha256", "stage_seed_u64", "randomness_used", "sequence_scope", "sequence", "input", "parameters", "patches", "rendering", "frames", "runtime", "finding_codes", "claims"],
  "properties": {
    "format": {"const": "oneclick2d.simple-cutout-comparator-report"},
    "format_version": {"const": "0.3.0"},
    "scope": {"const": "disposable-gate-f-spike"},
    "adapter_id": {"const": "simple-cutout.comparator.pillow.v1"},
    "adapter_version": {"const": "0.3.0"},
    "contract_id": {"const": "oc2d.spike.simple-cutout-comparator.v1"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "stage_seed_u64": {"$ref": "#/$defs/seed"},
    "randomness_used": {"const": true},
    "sequence_scope": {"const": "mandatory-neutral-endpoint-combination-seeded-trajectory"},
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "algorithm_id", "config_sha256", "seed_u64", "sha256", "parameter_scale", "mandatory_frame_count", "trajectory_frame_count", "frame_count"],
      "properties": {
        "profile_id": {"const": "oc2d.spike.gate-f-frame-sequence.v1"},
        "algorithm_id": {"const": "sha256-waypoint-linear-fixed-point.v1"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "seed_u64": {"$ref": "#/$defs/seed"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "parameter_scale": {"const": 1000},
        "mandatory_frame_count": {"const": 12},
        "trajectory_frame_count": {"const": 25},
        "frame_count": {"const": 37}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_raster_sha256", "normalization_report_sha256", "normalization_finding_codes", "width", "height", "mode", "bit_depth", "color_space", "alpha_mode"],
      "properties": {
        "normalized_raster_sha256": {"$ref": "#/$defs/sha256"},
        "normalization_report_sha256": {"$ref": "#/$defs/sha256"},
        "normalization_finding_codes": {"type": "array", "uniqueItems": true, "items": {"const": "RASTER_UNTAGGED_ASSUMED_SRGB"}},
        "width": {"type": "integer", "minimum": 1, "maximum": 8192},
        "height": {"type": "integer", "minimum": 1, "maximum": 8192},
        "mode": {"const": "RGBA"},
        "bit_depth": {"const": 8},
        "color_space": {"const": "srgb"},
        "alpha_mode": {"const": "straight"}
      }
    },
    "parameters": {"type": "object", "additionalProperties": false, "required": ["order", "side_convention"], "properties": {"order": {"const": ["head.yaw", "head.pitch", "eye.left.open", "eye.right.open", "mouth.open"]}, "side_convention": {"const": "character-anatomical"}}},
    "patches": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/head_patch"},
        {"$ref": "#/$defs/screen_left_eye_patch"},
        {"$ref": "#/$defs/screen_right_eye_patch"},
        {"$ref": "#/$defs/mouth_patch"}
      ],
      "items": false
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "profile_id", "coordinate_origin", "rectangle_quantization", "pivot", "feather", "head_transform_inheritance", "identity_patch_policy", "composition_order", "resampling", "rgba_filter_space", "alpha_composite", "outside_rgba", "base_erased", "png"],
      "properties": {
        "contract_id": {"const": "oc2d.spike.pillow-rgba-renderer.v1"},
        "profile_id": {"const": "pillow-12.1.0-bilinear-premultiplied-srgb-source-over.v2"},
        "coordinate_origin": {"const": "top-left"},
        "rectangle_quantization": {"const": "floor-min-ceil-max-half-open"},
        "pivot": {"const": "resolved-box-center"},
        "feather": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_pixels", "coverage"],
          "properties": {
            "source_pixels": {"const": 2},
            "coverage": {"const": "linear-inward-min-edge-distance"}
          }
        },
        "head_transform_inheritance": {"const": "locally-active-child-patches"},
        "identity_patch_policy": {"const": "skip-inactive-local-controls"},
        "composition_order": {"const": ["head", "eye.screen-left", "eye.screen-right", "mouth"]},
        "resampling": {"const": "pillow-bilinear"},
        "rgba_filter_space": {"const": "premultiplied-srgb-u8"},
        "alpha_composite": {"const": "porter-duff-source-over"},
        "outside_rgba": {"const": [0, 0, 0, 0]},
        "base_erased": {"const": false},
        "png": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compress_level", "optimize", "metadata"],
          "properties": {
            "compress_level": {"const": 9},
            "optimize": {"const": false},
            "metadata": {"const": "srgb-only"}
          }
        }
      }
    },
    "frames": {"type": "array", "minItems": 37, "maxItems": 37, "items": {"$ref": "#/$defs/frame"}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["pillow"], "properties": {"pillow": {"const": "12.1.0"}}},
    "finding_codes": {"type": "array", "maxItems": 0},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_decomposition_performed", "hidden_region_completion_performed", "psd_produced", "gate_f_feasibility_proven"],
      "properties": {
        "semantic_decomposition_performed": {"const": false},
        "hidden_region_completion_performed": {"const": false},
        "psd_produced": {"const": false},
        "gate_f_feasibility_proven": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "seed": {"type": "string", "pattern": "^(?:0[0-9]{19}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{7}|18446744073709[0-4][0-9]{6}|184467440737095[0-4][0-9]{4}|1844674407370955[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"},
    "patch_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 8192}},
    "patch_pivot_x2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 16384}},
    "head_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter_id", "character_side", "percent_xyxy", "pixel_box_ltrb", "pivot_source_pixel_x2"],
      "properties": {
        "id": {"const": "head"},
        "parameter_id": {"const": null},
        "character_side": {"const": "not-applicable"},
        "percent_xyxy": {"const": [20, 5, 80, 60]},
        "pixel_box_ltrb": {"$ref": "#/$defs/patch_box"},
        "pivot_source_pixel_x2": {"$ref": "#/$defs/patch_pivot_x2"}
      }
    },
    "screen_left_eye_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter_id", "character_side", "percent_xyxy", "pixel_box_ltrb", "pivot_source_pixel_x2"],
      "properties": {
        "id": {"const": "eye.screen-left"},
        "parameter_id": {"const": "eye.right.open"},
        "character_side": {"const": "right"},
        "percent_xyxy": {"const": [27, 25, 47, 40]},
        "pixel_box_ltrb": {"$ref": "#/$defs/patch_box"},
        "pivot_source_pixel_x2": {"$ref": "#/$defs/patch_pivot_x2"}
      }
    },
    "screen_right_eye_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter_id", "character_side", "percent_xyxy", "pixel_box_ltrb", "pivot_source_pixel_x2"],
      "properties": {
        "id": {"const": "eye.screen-right"},
        "parameter_id": {"const": "eye.left.open"},
        "character_side": {"const": "left"},
        "percent_xyxy": {"const": [53, 25, 73, 40]},
        "pixel_box_ltrb": {"$ref": "#/$defs/patch_box"},
        "pivot_source_pixel_x2": {"$ref": "#/$defs/patch_pivot_x2"}
      }
    },
    "mouth_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter_id", "character_side", "percent_xyxy", "pixel_box_ltrb", "pivot_source_pixel_x2"],
      "properties": {
        "id": {"const": "mouth"},
        "parameter_id": {"const": "mouth.open"},
        "character_side": {"const": "not-applicable"},
        "percent_xyxy": {"const": [40, 42, 60, 56]},
        "pixel_box_ltrb": {"$ref": "#/$defs/patch_box"},
        "pivot_source_pixel_x2": {"$ref": "#/$defs/patch_pivot_x2"}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head.yaw", "head.pitch", "eye.left.open", "eye.right.open", "mouth.open"],
      "properties": {
        "head.yaw": {"type": "number", "minimum": -15, "maximum": 15},
        "head.pitch": {"type": "number", "minimum": -10, "maximum": 10},
        "eye.left.open": {"type": "number", "minimum": 0, "maximum": 1},
        "eye.right.open": {"type": "number", "minimum": 0, "maximum": 1},
        "mouth.open": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "id", "source", "parameters", "artifact"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 36},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
        "source": {"enum": ["mandatory", "seeded-trajectory"]},
        "parameters": {"$ref": "#/$defs/parameters"},
        "artifact": {"type": "object", "additionalProperties": false, "required": ["name", "role", "media_type", "sha256", "byte_length"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"}, "role": {"const": "simple_cutout_frame"}, "media_type": {"const": "image/png"}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"type": "integer", "minimum": 1}}}
      }
    }
  }
}
