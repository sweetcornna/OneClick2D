{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oneclick2d.invalid/run-manifest/v0.2/run-manifest.schema.json",
  "title": "OneClick2D Disposable Gate F Run Manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "scope", "run_id", "run_spec_sha256", "root_seed_u64", "started_at", "completed_at", "terminal_status", "application", "environment", "source", "stages"],
  "properties": {
    "format": {"const": "oneclick2d.run-manifest"},
    "format_version": {"const": "0.2.0"},
    "scope": {"const": "disposable-gate-f-spike"},
    "run_id": {"$ref": "#/$defs/id"},
    "run_spec_sha256": {"$ref": "#/$defs/sha256"},
    "root_seed_u64": {"type": "string", "pattern": "^[0-9]{20}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "terminal_status": {"enum": ["succeeded", "review", "fallback", "blocked", "cancelled", "failed"]},
    "terminal_reason_code": {"$ref": "#/$defs/reasonCode"},
    "application": {"$ref": "#/$defs/application"},
    "environment": {"$ref": "#/$defs/environment"},
    "source": {"$ref": "#/$defs/artifact"},
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
    "result": {"$ref": "#/$defs/artifact"}
  },
  "allOf": [
    {
      "if": {"properties": {"terminal_status": {"enum": ["succeeded", "review", "fallback"]}}, "required": ["terminal_status"]},
      "then": {"required": ["result"], "not": {"required": ["terminal_reason_code"]}}
    },
    {
      "if": {"properties": {"terminal_status": {"enum": ["blocked", "cancelled", "failed"]}}, "required": ["terminal_status"]},
      "then": {"required": ["terminal_reason_code"], "not": {"required": ["result"]}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
    "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "application": {"type": "object", "additionalProperties": false, "required": ["version", "build_id", "source_revision"], "properties": {"version": {"type": "string", "minLength": 1}, "build_id": {"$ref": "#/$defs/id"}, "source_revision": {"$ref": "#/$defs/id"}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["os", "cpu", "python", "python_implementation", "execution_provider", "execution_profile", "precision"], "properties": {"os": {"type": "string", "minLength": 1}, "cpu": {"type": "string", "minLength": 1}, "python": {"type": "string", "minLength": 1}, "python_implementation": {"type": "string", "minLength": 1}, "execution_provider": {"enum": ["python-stdlib", "pillow-12.1.0"]}, "execution_profile": {"enum": ["python-stdlib-in-process-v1", "python-pillow-12.1.0-in-process-v1"]}, "precision": {"const": "not-applicable"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["role", "media_type", "uri", "sha256", "byte_length"], "properties": {"role": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 3}, "uri": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"$ref": "#/$defs/safeInteger"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_wall_time_ms", "max_cpu_time_ms", "max_peak_ram_bytes", "max_scratch_bytes", "max_output_bytes", "max_output_files", "max_peak_vram_bytes", "gpu_allowed"], "properties": {"max_wall_time_ms": {"$ref": "#/$defs/safeInteger"}, "max_cpu_time_ms": {"$ref": "#/$defs/safeInteger"}, "max_peak_ram_bytes": {"$ref": "#/$defs/safeInteger"}, "max_scratch_bytes": {"$ref": "#/$defs/safeInteger"}, "max_output_bytes": {"$ref": "#/$defs/safeInteger"}, "max_output_files": {"$ref": "#/$defs/safeInteger"}, "max_peak_vram_bytes": {"const": 0}, "gpu_allowed": {"const": false}}},
    "enforcement": {"type": "object", "additionalProperties": false, "required": ["output", "scratch", "wall_time", "cpu_time", "ram", "vram", "egress"], "properties": {"output": {"const": "hard"}, "scratch": {"const": "post-stage-observed"}, "wall_time": {"const": "cooperative-post-stage-observed"}, "cpu_time": {"const": "post-stage-observed"}, "ram": {"const": "unavailable"}, "vram": {"const": "not-applicable"}, "egress": {"const": "not-enforced-in-process"}}},
    "stage": {"type": "object", "additionalProperties": false, "required": ["id", "attempt_id", "contract_id", "stage_type", "adapter_id", "implementation_version", "producer_kind", "determinism", "resolved_stage_spec_sha256", "config_sha256", "seed_u64", "input_sha256", "outputs", "status", "reason_code", "finding_codes", "duration_ms", "cpu_time_ms", "limits", "enforcement", "scratch_cleaned"], "properties": {"id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "contract_id": {"$ref": "#/$defs/id"}, "stage_type": {"type": "string", "pattern": "^oc2d\\.spike\\.[a-z0-9.-]+$"}, "adapter_id": {"$ref": "#/$defs/id"}, "implementation_version": {"type": "string", "minLength": 1}, "producer_kind": {"enum": ["deterministic", "model_backed"]}, "determinism": {"enum": ["byte-exact", "numeric-tolerance", "nondeterministic-declared"]}, "resolved_stage_spec_sha256": {"$ref": "#/$defs/sha256"}, "config_sha256": {"$ref": "#/$defs/sha256"}, "seed_u64": {"type": "string", "pattern": "^[0-9]{20}$"}, "input_sha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}}, "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}, "status": {"enum": ["succeeded", "review", "fallback", "blocked", "cancelled", "failed"]}, "reason_code": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reasonCode"}]}, "finding_codes": {"type": "array", "items": {"$ref": "#/$defs/reasonCode"}}, "duration_ms": {"$ref": "#/$defs/safeInteger"}, "cpu_time_ms": {"$ref": "#/$defs/safeInteger"}, "limits": {"$ref": "#/$defs/limits"}, "enforcement": {"$ref": "#/$defs/enforcement"}, "scratch_cleaned": {"const": true}}, "allOf": [{"if": {"properties": {"status": {"enum": ["blocked", "cancelled", "failed"]}}}, "then": {"properties": {"reason_code": {"$ref": "#/$defs/reasonCode"}}}}, {"if": {"properties": {"status": {"enum": ["succeeded", "review", "fallback"]}}}, "then": {"properties": {"reason_code": {"type": "null"}}}}, {"if": {"properties": {"status": {"enum": ["cancelled", "failed"]}}}, "then": {"properties": {"outputs": {"maxItems": 0}}}}]}
  }
}
